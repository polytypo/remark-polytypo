{
  "name": "remark-polytypo",
  "version": "1.0.0",
  "description": "remark plugin: typographic cleanup of Markdown and MDX with polytypo",
  "keywords": [
    "remark",
    "remark-plugin",
    "unified",
    "mdx",
    "markdown",
    "typography",
    "smart-quotes",
    "polytypo",
    "i18n"
  ],
  "homepage": "https://polytypo.dev/",
  "bugs": {
    "url": "https://github.com/polytypo/remark-polytypo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polytypo/remark-polytypo.git"
  },
  "license": "MIT",
  "author": "Iurii Rogulia",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.27.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:packed-tarball": "node scripts/packed-tarball.mjs",
    "check:workflow-shell-safety": "node scripts/check-workflow-shell-safety.mjs",
    "check:actions-pinned": "node scripts/check-actions-pinned.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "polytypo": "^1.16.0"
  },
  "peerDependencies": {
    "unified": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-smartypants": "^3.0.3",
    "remark-stringify": "^11.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
